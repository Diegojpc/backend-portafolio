# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
DATABASE_URL=sqlite+aiosqlite:///./storage/portfolio.db
APP_SECRET=change-me-to-a-random-string-of-32-or-more-characters
GEMINI_API_KEY=            # Google AI Studio key
CORS_ORIGINS=http://localhost:5173

# --- Chat model ---
MODEL_NAME=gemini-3.8-flash

# --- Optional ---
# S3_BUCKET=               # load RAG documents from S3 instead of backend/data/
# ENABLE_DOCS=false        # true exposes /docs, /redoc, /openapi.json

# --- Voice call (disabled unless REALTIME_ENABLED=true; it spends money per visitor) ---
REALTIME_ENABLED=false
# FISH_API_KEY=
# FISH_VOICE_ID=           # reference_id of your cloned voice on fish.audio
# FISH_VOICE_ID_EN=        # optional second clone used for English sentences (record it speaking English)
# FISH_MODEL=s2.1-pro-free
# FISH_SPEED=1.15          # delivery pace without re-cloning (1.0 = natural, 0.5-2.0)
# FISH_SPEED_EN=           # optional different pace for English
# FISH_TEMPERATURE=0.7     # 0-1: higher = more expressive
# REALTIME_DAILY_CHARS=20000
# REALTIME_MAX_TURNS=12
